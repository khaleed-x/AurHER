@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Something Went Wrong";
}

<div style="max-width:600px;margin:100px auto;padding:0 32px;text-align:center;">
    <div style="font-size:4rem;margin-bottom:16px;">🛠️</div>
    <h1 style="font-size:1.8rem;font-weight:800;color:var(--text-primary);margin-bottom:12px;">
        We'll Be Right Back
    </h1>
    <p style="font-size:0.9rem;color:var(--text-muted);line-height:1.7;margin-bottom:28px;">
        AurHER is currently undergoing maintenance.
        Please check back in a few minutes — we're working hard to fix this!
    </p>
    <a href="/"
       style="display:inline-flex;align-items:center;gap:8px;padding:12px 28px;background:var(--primary);color:white;border-radius:999px;font-size:0.875rem;font-weight:700;text-decoration:none;">
        Try Again
    </a>
</div>